# Token del bot de Telegram (obtenido de @BotFather)
BOT_TOKEN=tu_token_aqui

# Ruta de la base de datos SQLite
DB_PATH=./database/bot.sqlite

# IDs de administradores (separados por coma, opcional)
ADMIN_IDS=

# Proxy (opcional — solo si lo necesitas por restricciones de red)
# PROXY_URL=socks5h://127.0.0.1:1080

# Zona horaria (opcional)
# TZ=America/Havana